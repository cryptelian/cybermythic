{
  "scripts": {
    "build": "vite build -c config/build/vite.config.ts && node ./scripts/build/copyDist.mjs",
    "build:copy-dist": "node ./scripts/build/copyDist.mjs",
    "build:watch": "node ./scripts/build/watch-init.mjs && concurrently \"vite build --watch -c config/build/vite.config.ts\" \"sass --watch src/styles/main.scss:dist/dist/style.css --source-map --embed-sources\"",
    "build:styles": "sass src/styles/main.scss dist/dist/style.css --source-map --embed-sources",
    "build:styles:optimized": "sass src/styles/main.scss dist/dist/style.css --style=compressed --embed-sources",
    "build:styles:watch": "sass --watch src/styles/main.scss:dist/dist/style.css --source-map --embed-sources",
    "build:critical": "sass src/styles/build/critical.scss public/style/critical.css --style=compressed --no-source-map",
    "run": "vite serve -c config/build/vite.config.ts",
    "build:production": "vite build --mode production -c config/build/vite.config.ts && node ./scripts/build/copyDist.mjs",
    "dev": "npm run build && vite serve -c config/build/vite.config.ts",
    "dev:watch": "concurrently \"npm run build:styles:watch\" \"npm run run\"",
    "packCompendiumsToDist": "node ./scripts/build/packCompendiumsToDist.mjs",
    "packCompendiumsToPublic": "node ./scripts/build/packCompendiumsToPublic.mjs",
    "unpackCompendiumsFromPublic": "node ./scripts/build/unpackCompendiumsFromPublic.mjs",
    "build:main": "npx vite build -c config/build/vite.config.ts",
    "dev:main": "npx vite serve -c config/build/vite.config.ts",
    "build:ninja": "vite build --mode ninja -c config/build/vite.config.ts && node ./scripts/build/rewriteSystemJson.mjs && node ./scripts/build/packCompendiumsWithRewrite.mjs && node ./scripts/build/copyDist.mjs",
    "build:ninja:to": "OUT_DIR=$OUT_DIR vite build --mode ninja -c config/build/vite.config.ts && OUT_DIR=$OUT_DIR node ./scripts/build/rewriteSystemJson.mjs && OUT_DIR=$OUT_DIR node ./scripts/build/packCompendiumsWithRewrite.mjs && node ./scripts/build/copyDist.mjs",
    "dev:ninja": "vite serve --mode ninja -c config/build/vite.config.ts",
    "lint": "eslint \"src/**/*.js\" \"public/**/*.mjs\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint --config config/code/.stylelintrc.json --ignore-path config/code/.stylelintignore \"src/styles/**/*.scss\"",
    "stylelint:fix": "stylelint --config config/code/.stylelintrc.json --ignore-path config/code/.stylelintignore \"src/styles/**/*.scss\" --fix",
    "lint:css": "stylelint --config config/code/.stylelintrc.json --ignore-path config/code/.stylelintignore \"src/**/*.scss\"",
    "lint:css:fix": "stylelint --config config/code/.stylelintrc.json --ignore-path config/code/.stylelintignore \"src/**/*.scss\" --fix",
    "analyze:styles": "node scripts/validation/style-analyzer.js",
    "docs:generate": "node scripts/validation/style-docs-generator.js",
    "test:styles": "npm run stylelint && npm run build:styles && npm run analyze:styles",
    "dev:full": "concurrently \"npm run build:styles:watch\" \"npm run stylelint -- --watch\" \"npm run run\"",
    "validate:all": "npm run lint && npm run stylelint && npm run build:styles && npm run build:critical",
    "validate:system": "node ./scripts/validation/validateSystemJson.mjs",
    "validate:i18n": "node ./scripts/validation/validateI18n.mjs",
    "validate:manifest": "node ./scripts/validation/validateManifestAssets.mjs",
    "validate:dist": "npm run validate:structure && npm run validate:manifest && npm run smoke",
    "validate": "npm run validate:system && npm run validate:i18n",
    "smoke": "node ./scripts/validation/smoke.mjs",
    "validate:structure": "node ./scripts/validation/validateStructure.mjs",
    "qa:test": "node scripts/validation/qa-testing.js",
    "qa:full": "npm run validate:all && npm run qa:test",
    "metrics:baseline": "node ./scripts/utilities/metrics-baseline.mjs",
    "metrics:ci": "node ./scripts/utilities/metrics-baseline.mjs --skip-build",
    "lint:styles": "stylelint --config config/code/.stylelintrc.json --ignore-path config/code/.stylelintignore \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint --config config/code/.stylelintrc.json --ignore-path config/code/.stylelintignore \"src/**/*.scss\" --fix",
    "test": "vitest run -c config/build/vitest.config.mjs",
    "test:watch": "vitest",
    "test:visual": "npm run -s build && playwright test",
    "test:visual:update": "npm run -s build && playwright test --update-snapshots",
    "release:prepare": "node ./scripts/build/prepareRelease.mjs --repo VincentVk9373/anarchy --version v$npm_package_version",
    "ci": "npm run format:check && npm run lint:css && npm run validate && npm run -s build && npm run validate:dist && npm test",
    "prepare": "husky && node ./scripts/utilities/patch-husky-gitkraken.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.3",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@league-of-foundry-developers/foundry-vtt-types": "^9.280.0",
    "@playwright/test": "^1.47.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cssnano": "^6.1.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.7",
    "nodemon": "^3.1.2",
    "postcss": "^8.4.47",
    "postcss-load-config": "^5.1.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "sass": "^1.77.4",
    "stylelint": "^16.8.1",
    "stylelint-config-clean-order": "^5.4.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.5.0",
    "vite": "^5.2.12",
    "vitest": "^2.0.5",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "rollup-plugin-visualizer": "^5.12.0",
    "yaml": "^2.6.1"
  },
  "overrides": {
    "socket.io-parser": "^4.2.3",
    "socket.io-client": "^4.7.5",
    "ws": "^8.17.1",
    "engine.io-client": "^6.5.4",
    "tinymce": "^6.8.6"
  }
}
