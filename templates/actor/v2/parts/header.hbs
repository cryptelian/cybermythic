<header class="sheet-header">
  <div class="identity">
    <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" class="profile-img"/>
    <div class="name-block">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Name"/>
      <div class="metatype">
        {{!-- Metatype would typically be an item or field --}}
        <label>Metatype:</label> <span>{{system.metatype}}</span>
      </div>
    </div>
  </div>
</header>
