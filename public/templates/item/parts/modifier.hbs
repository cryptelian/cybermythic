<tr class="modifier-row define-modifier" data-modifier-id="{{id}}">
  <div class="modifier-group">
    <label>{{localize 'ANARCHY.modifier.group'}}</label>
    {{selectOptions (modifierSelectOption 'group') selected=modifier.group localize=true name=(concat "system.modifiers."
    modifier.id ".group") class="modifier-select-group"}}
  </div>
  <div class="modifier-effect">
    <label>{{localize 'ANARCHY.modifier.effect'}}</label>
    {{selectOptions (modifierSelectOption 'effect' group=group) selected=modifier.effect localize=true name=(concat
    "system.modifiers." modifier.id ".effect") class="modifier-select-effect"}}
  </div>
  <div class="modifier-category">
    <label>{{localize 'ANARCHY.modifier.category'}}</label>
    {{selectOptions (modifierSelectOption 'category' group=group effect=effect) selected=modifier.category localize=true
    name=(concat "system.modifiers." modifier.id ".category") class="modifier-select-category"}}
  </div>
  <div class="modifier-subcategory">
    <label>{{localize 'ANARCHY.modifier.subCategory'}}</label>
    {{selectOptions (modifierSelectOption 'subCategory' group=group effect=effect category=category)
    selected=modifier.subCategory localize=true name=(concat "system.modifiers." modifier.id ".subCategory")
    class="modifier-select-subcategory"}}
  </div>
  <td class="modifier-column">
    {{numberInput value min=-2 max=4 class='input-modifier-value' step=1}}
  </td>
  <td class="modifier-column">
    <input class="input-modifier-condition" type="text" value="{{condition}}" placeholder="{{localize ANARCHY.modifier.condition.always}}"/>
  </td>
  <td class="modifier-column modifier-controls item-controls">
    <a class="item-control click-modifier-delete" data-tooltip="{{localize ANARCHY.common.del}}">
      {{{iconFA 'fas fa-trash'}}}
    </a>
  </td>
</tr>
