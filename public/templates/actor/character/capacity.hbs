<div class="info-label">
  <select class="info-value character-capacity" name="system.capacity"
  {{#if @root.options.viewMode}}disabled{{/if}}>
    {{selectOptions ENUMS.capacity selected=system.capacity localize=true name="system.capacity" class="select-capacity"
    data-dtype="String"}}
  </select>
  {{#if (eq system.capacity 'emerged')}}
  {{> 'systems/anarchy/templates/common/control-connectionMode.hbs' connectionMode=system.connectionMode}}
  {{/if}}
</div>
